{
	"name": "choctaw-nation/cno-plugin-lite-vimeo-block",
	"description": "A block that uses lite-vimeo to load Vimeo videos in a lightweight, performant way.",
	"type": "project",
	"version": "2.0.0",
	"autoload": {
		"classmap": [
			"inc/"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://composer.advancedcustomfields.com"
		}
	],
	"scripts": {
		"phpcs": "phpcs inc/ cno-plugin-lite-vimeo-block.php --extensions=php",
		"phpcbf": "phpcbf inc/ cno-plugin-lite-vimeo-block.php --extensions=php",
		"test": "phpunit",
		"install-tests": [
			"chmod +x bin/local-mysql-socket.sh",
			"bash -lc 'SOCK=\"$(bin/local-mysql-socket.sh)\"; bash -x bin/install-wp-tests.sh wordpress_test root root \"$SOCK\" latest'"
		]
	},
	"require-dev": {
		"doctrine/instantiator": "^1",
		"phpunit/phpunit": "^9",
		"wp-coding-standards/wpcs": "*",
		"yoast/phpunit-polyfills": "^4.0"
	}
}
