{
	"name": "cno-plugin-lite-vimeo-block",
	"version": "2.0.0",
	"description": "A block that uses lite-vimeo to load Vimeo videos in a lightweight, performant way.",
	"author": "Choctaw Nation of Oklahoma",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/choctawnation/cno-plugin-lite-vimeo-block",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --experimental-modules",
		"format": "wp-scripts format",
		"lint:css": "npx stylelint 'src/**/*.scss' 'src/**/*.css' --fix",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts build --blocks-manifest --experimental-modules && wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest --experimental-modules"
	},
	"files": [
		"build",
		"inc",
		"vendor",
		"cno-plugin-lite-vimeo-block.php"
	],
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@wordpress/blob": "^4.45.0",
		"@wordpress/block-editor": "^15.18.0",
		"@wordpress/blocks": "^15.18.0",
		"@wordpress/components": "^33.0.0",
		"@wordpress/data": "^10.45.0",
		"@wordpress/element": "^6.45.0",
		"@wordpress/eslint-plugin": "^25.1.0",
		"@wordpress/icons": "^13.0.0",
		"@wordpress/interactivity": "^6.45.0",
		"@wordpress/scripts": "^32.1.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "npm:wp-prettier@^3",
		"stylelint": "^17.11.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.57.1"
	}
}
